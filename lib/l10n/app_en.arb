  "invSetOutputPriority": "Output source priority",
  "invSetOutputPriorityDesc": "Which source powers the loads (program 01). USB: AC input first; solar and battery only when AC input is missing. SUB: solar charges the battery first, then feeds the loads; AC input covers the rest. SBU: solar first, then battery; AC input only when the battery falls to the back-to-AC point (program 12/43). Off-grid: use SBU.",
  "invSetChargerPriority": "Charger source priority",
  "invSetChargerPriorityDesc": "Which source charges the battery (program 16). CSO: solar first, AC input only when there is no sun. SNU: solar and AC input together. OSO: solar only, even when AC input is present. Without a generator on the AC input, only solar can charge.",
  "invSetMaxChargeCurrent": "Maximum charging current",
  "invSetMaxChargeCurrentDesc": "Total battery charging current, solar + AC input (program 02). It cannot be lower than the AC charging current (program 11). Stay within the battery maker's limit.",
  "invSetAcChargeCurrent": "Maximum AC charging current",
  "invSetAcChargeCurrentDesc": "Maximum current used to charge the battery from the AC input, grid or generator (program 11). Keep it low enough for the generator and the input breaker.",
  "invSetAcInputRange": "AC input voltage range",
  "invSetAcInputRangeDesc": "Accepted AC input voltage (program 03). APL (appliances): 90-280 V, wide range. UPS: 170-280 V, narrow range for sensitive loads. The wide range copes better with a generator whose voltage fluctuates.",
  "invSetBatteryType": "Battery type",
  "invSetBatteryTypeDesc": "Battery chemistry; it sets the charge voltages (program 05). AGM and Flooded: lead-acid presets. User-defined: you set bulk, float and cut-off voltages (programs 26, 27, 29). LIB/LiFe: lithium.",
  "invSetOverloadRestart": "Auto restart after overload",
  "invSetOverloadRestartDesc": "If enabled, the output turns back on by itself after an overload shutdown (program 06).",
  "invSetOverTempRestart": "Auto restart after over-temperature",
  "invSetOverTempRestartDesc": "If enabled, the output turns back on by itself after an over-temperature shutdown (program 07).",
  "invSetOutputVoltage": "Output voltage",
  "invSetOutputVoltageDesc": "AC voltage supplied to the loads (program 08). Europe: 230 V.",
  "invSetOutputFrequency": "Output frequency",
